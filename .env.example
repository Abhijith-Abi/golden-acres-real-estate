# Copy this file to .env.local and set the values for your environment.

# Canonical production origin. Keep this aligned with the Vercel primary domain.
NEXT_PUBLIC_SITE_URL="https://www.goldenacresrealestate.co.in"

# Google Search Console HTML-tag verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="google008d788f2689e4cb"

# Optional Bing Webmaster Tools HTML-tag verification token.
# NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# Optional lead delivery. Leave both unset to hand submissions to WhatsApp.
# Set the public flag only after the server webhook URL is configured.
# ENQUIRY_WEBHOOK_URL="https://your-real-webhook.example/path"
# NEXT_PUBLIC_ENQUIRY_BACKEND_CONFIGURED="true"
# ENQUIRY_WEBHOOK_TOKEN="your-server-only-token"
